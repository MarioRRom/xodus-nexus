+/* The base game is the current Game package, not a Content package returned by
+ * XPackageEnumeratePackages. Resolve it only when its identifier matches the
+ * running package configured by MicrosoftGame.config. This selects the Store
+ * product; the subsequent license still requires fresh signed Store proof. */
+static HRESULT package_license_resolve_store( const char *identifier, char store[13] )
+{
+    HRESULT hr = xpackage_query_content_store( identifier, 13, store );
+    char current[33] = {};
+
+    if (hr != E_GAMEPACKAGE_NO_PACKAGE_IDENTIFIER) return hr;
+    if (!entitled_id(storeId) ||
+        FAILED(xpackage_query_identifier(storeId, sizeof(current), current)) ||
+        stricmp(identifier, current)) return hr;
+
+    memcpy(store, storeId, 13);
+    return S_OK;
+}
+
 static HRESULT package_license_begin( XStoreContextHandle store, const char *identifier, XAsyncBlock *async )
 {
     struct package_license_async *context;
